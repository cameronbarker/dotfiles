#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "${SCRIPT_PATH}" ]]; do
  SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
  LINK_TARGET="$(readlink "${SCRIPT_PATH}")"
  if [[ "${LINK_TARGET}" == /* ]]; then
    SCRIPT_PATH="${LINK_TARGET}"
  else
    SCRIPT_PATH="${SCRIPT_DIR}/${LINK_TARGET}"
  fi
done
BIN_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
# shellcheck source=ai-kit/lib/common.sh
source "${BIN_DIR}/../lib/common.sh"

usage() {
  cat <<'USAGE'
Usage: ai-context [--force]

Generate ai-context orientation files.
Refuses to overwrite a non-empty ai-context/ directory unless --force is provided.
USAGE
}

ai_ctx_yaml_scalar() {
  local file="$1" target="$2"
  [[ -f "$file" ]] || return 0

  awk -v target="$target" '
    function trim(s) {
      sub(/^[[:space:]]+/, "", s)
      sub(/[[:space:]]+$/, "", s)
      return s
    }
    function unquote(s) {
      s = trim(s)
      if (s ~ /^".*"$/ || s ~ /^'\''.*'\''$/) {
        s = substr(s, 2, length(s) - 2)
      }
      return s
    }
    {
      line = $0
      sub(/\r$/, "", line)
      if (line ~ /^[[:space:]]*#/ || line ~ /^[[:space:]]*$/) next

      indent = match(line, /[^ ]/) - 1
      if (indent < 0) indent = 0
      content = substr(line, indent + 1)

      while (depth > 0 && indent <= indents[depth]) {
        depth--
      }

      if (content ~ /^[A-Za-z0-9_]+:[[:space:]]*/) {
        key = content
        sub(/:.*/, "", key)
        val = content
        sub(/^[^:]+:[[:space:]]*/, "", val)

        depth++
        keys[depth] = key
        indents[depth] = indent

        path = keys[1]
        for (i = 2; i <= depth; i++) path = path "." keys[i]
        current = path

        if (current == target && val != "") {
          val = trim(val)
          if (val !~ /^\[.*\]$/) {
            print unquote(val)
            exit
          }
        }
      }
    }
  ' "$file"
}

ai_ctx_yaml_list() {
  local file="$1" target="$2"
  [[ -f "$file" ]] || return 0

  awk -v target="$target" '
    function trim(s) {
      sub(/^[[:space:]]+/, "", s)
      sub(/[[:space:]]+$/, "", s)
      return s
    }
    function unquote(s) {
      s = trim(s)
      if (s ~ /^".*"$/ || s ~ /^'\''.*'\''$/) {
        s = substr(s, 2, length(s) - 2)
      }
      return s
    }
    {
      line = $0
      sub(/\r$/, "", line)
      if (line ~ /^[[:space:]]*#/ || line ~ /^[[:space:]]*$/) next

      indent = match(line, /[^ ]/) - 1
      if (indent < 0) indent = 0
      content = substr(line, indent + 1)

      while (depth > 0 && indent <= indents[depth]) {
        depth--
      }

      if (content ~ /^-[[:space:]]+/) {
        item = substr(content, 3)
        if (current == target) {
          print unquote(item)
        }
        next
      }

      if (content ~ /^[A-Za-z0-9_]+:[[:space:]]*/) {
        key = content
        sub(/:.*/, "", key)
        val = content
        sub(/^[^:]+:[[:space:]]*/, "", val)

        depth++
        keys[depth] = key
        indents[depth] = indent

        path = keys[1]
        for (i = 2; i <= depth; i++) path = path "." keys[i]
        current = path

        if (current == target) {
          val = trim(val)
          if (val ~ /^\[.*\]$/) {
            inner = val
            sub(/^\[/, "", inner)
            sub(/\]$/, "", inner)
            n = split(inner, arr, ",")
            for (j = 1; j <= n; j++) {
              item = unquote(arr[j])
              if (item != "") print item
            }
          } else if (val != "") {
            print unquote(val)
          }
        }
      }
    }
  ' "$file"
}

ai_ctx_risk_rules_md() {
  local file="$1"
  [[ -f "$file" ]] || return 0

  awk '
    function trim(s) {
      sub(/^[[:space:]]+/, "", s)
      sub(/[[:space:]]+$/, "", s)
      return s
    }
    function unquote(s) {
      s = trim(s)
      if (s ~ /^".*"$/ || s ~ /^'\''.*'\''$/) {
        s = substr(s, 2, length(s) - 2)
      }
      return s
    }
    function value_after_colon(line,    v) {
      v = line
      sub(/^[^:]+:[[:space:]]*/, "", v)
      return unquote(v)
    }
    function flush_rule() {
      if (path != "") {
        printf "- path: `%s`", path
        if (level != "") printf " | level: `%s`", level
        if (action != "") printf " | action: `%s`", action
        if (reason != "") printf " | reason: %s", reason
        printf "\n"
        count++
      }
      path=""; level=""; action=""; reason=""
    }
    {
      line = $0
      sub(/\r$/, "", line)
      if (line ~ /^[[:space:]]*#/) next

      if (line ~ /^rules:[[:space:]]*$/) {
        in_rules = 1
        next
      }
      if (in_rules && line ~ /^[^[:space:]]/ && line !~ /^rules:[[:space:]]*$/) {
        flush_rule()
        in_rules = 0
      }
      if (!in_rules) next

      if (line ~ /^[[:space:]]*-[[:space:]]*path:[[:space:]]*/) {
        flush_rule()
        path = value_after_colon(line)
      } else if (line ~ /^[[:space:]]*level:[[:space:]]*/) {
        level = value_after_colon(line)
      } else if (line ~ /^[[:space:]]*action:[[:space:]]*/) {
        action = value_after_colon(line)
      } else if (line ~ /^[[:space:]]*reason:[[:space:]]*/) {
        reason = value_after_colon(line)
      }
    }
    END {
      flush_rule()
      if (count == 0) {
        print "- (no rules found)"
      }
    }
  ' "$file"
}

force=0
case "${1:-}" in
  --help|-h)
    usage
    exit 0
    ;;
  --force)
    force=1
    shift
    ;;
esac

if [[ "$#" -gt 0 ]]; then
  usage >&2
  exit 64
fi

root="$(ai_kit_repo_root)"
config_file="${root}/.codex/project.yml"

if [[ ! -f "$config_file" ]]; then
  echo "Missing required config: .codex/project.yml" >&2
  echo "Create one from ai-kit/templates/project.yml.example" >&2
  exit 2
fi

repo_name="$(ai_ctx_yaml_scalar "$config_file" "project.name")"
repo_type="$(ai_ctx_yaml_scalar "$config_file" "project.type")"
risk_file="$(ai_ctx_yaml_scalar "$config_file" "risk.config_file")"
out_dir_rel="$(ai_ctx_yaml_scalar "$config_file" "ai_context.output_dir")"
test_cmd="$(ai_ctx_yaml_scalar "$config_file" "commands.test")"

primary_languages=()
while IFS= read -r line; do
  [[ -n "$line" ]] && primary_languages+=("$line")
done < <(ai_ctx_yaml_list "$config_file" "project.primary_languages")

include_paths=()
while IFS= read -r line; do
  [[ -n "$line" ]] && include_paths+=("$line")
done < <(ai_ctx_yaml_list "$config_file" "ai_context.include")

exclude_paths=()
while IFS= read -r line; do
  [[ -n "$line" ]] && exclude_paths+=("$line")
done < <(ai_ctx_yaml_list "$config_file" "ai_context.exclude")

run_cmds=()
while IFS= read -r line; do
  [[ -n "$line" ]] && run_cmds+=("$line")
done < <(ai_ctx_yaml_list "$config_file" "commands.run")

repo_name="${repo_name:-}"
repo_type="${repo_type:-unknown}"
risk_file="${risk_file:-.codex/risk-paths.yml}"
out_dir_rel="${out_dir_rel:-ai-context}"
test_cmd="${test_cmd:-}"
out_dir="${root}/${out_dir_rel}"

if [[ -d "$out_dir" ]]; then
  if find "$out_dir" -mindepth 1 -print -quit 2>/dev/null | grep -q .; then
    if [[ "$force" -ne 1 ]]; then
      echo "Refusing to overwrite non-empty ${out_dir}. Re-run with --force." >&2
      exit 2
    fi
  fi
fi

mkdir -p "$out_dir"

branch="unknown"
sha="unknown"
dirty=false
if command -v git >/dev/null 2>&1; then
  if branch_raw="$(git -C "$root" branch --show-current 2>/dev/null)"; then
    branch_raw="$(printf '%s' "$branch_raw" | tr -d '\r\n')"
    if [[ -n "$branch_raw" ]]; then
      branch="$branch_raw"
    else
      branch="detached"
    fi
  fi
  if sha_raw="$(git -C "$root" rev-parse --short HEAD 2>/dev/null)"; then
    sha_raw="$(printf '%s' "$sha_raw" | tr -d '\r\n')"
    if [[ -n "$sha_raw" ]]; then
      sha="$sha_raw"
    fi
  fi
  if [[ -n "$(git -C "$root" status --short 2>/dev/null || true)" ]]; then
    dirty=true
  fi
fi

risk_json=""
risk_note="ai-risk unavailable"
if [[ -x "${BIN_DIR}/ai-risk" ]]; then
  risk_json="$({ "${BIN_DIR}/ai-risk" --json 2>/dev/null || true; } | tail -n 1)"
  if [[ -n "$risk_json" ]]; then
    risk_note="Embedded from ai-risk --json"
  fi
fi

cat > "${out_dir}/README.md" <<'MD'
# AI Context

This folder is generated orientation material for planning/discussion.

Warning: generated context is orientation-only. Repository source files remain authoritative.
MD

cat > "${out_dir}/project-overview.md" <<'MD'
# Project Overview

- Project name: __PROJECT_NAME__
- Project type: __PROJECT_TYPE__

Generated context only; inspect live files before implementation.
MD
project_name_escaped="$(printf '%s' "${repo_name}" | sed 's/[\\&/]/\\&/g')"
project_type_escaped="$(printf '%s' "${repo_type}" | sed 's/[\\&/]/\\&/g')"
awk -v name="${project_name_escaped}" -v type="${project_type_escaped}" '
  { gsub(/__PROJECT_NAME__/, name); gsub(/__PROJECT_TYPE__/, type); print }
' \
  "${out_dir}/project-overview.md" > "${out_dir}/project-overview.md.tmp"
mv "${out_dir}/project-overview.md.tmp" "${out_dir}/project-overview.md"
{
  if [[ ${#primary_languages[@]} -gt 0 ]]; then
    printf -- "- Primary languages: "
    printf '%s' "${primary_languages[0]}"
    for ((i = 1; i < ${#primary_languages[@]}; i++)); do
      printf ', %s' "${primary_languages[i]}"
    done
    printf '\n'
  else
    echo "- Primary languages: unknown"
  fi
} >> "${out_dir}/project-overview.md"

{
  echo "# Architecture Map"
  echo
  echo "Configured include paths:"
  if [[ ${#include_paths[@]} -eq 0 ]]; then
    echo "- (none configured)"
  else
    for p in "${include_paths[@]}"; do
      echo "- \`$p\`"
    done
  fi
  echo
  echo "Configured exclude paths:"
  if [[ ${#exclude_paths[@]} -eq 0 ]]; then
    echo "- (none configured)"
  else
    for p in "${exclude_paths[@]}"; do
      echo "- \`$p\`"
    done
  fi
  echo
  echo "Observed top-level paths:"
  while IFS= read -r entry; do
    [[ -n "$entry" ]] && echo "- \`$entry\`"
  done < <(find "$root" -mindepth 1 -maxdepth 1 -exec basename {} \; | LC_ALL=C sort)
} > "${out_dir}/architecture-map.md"

{
  echo "# Commands"
  echo
  if [[ -n "$test_cmd" ]]; then
    echo "Test command:"
    echo '```bash'
    echo "$test_cmd"
    echo '```'
    echo
  else
    echo "Test command: (not configured)"
    echo
  fi

  if [[ ${#run_cmds[@]} -gt 0 ]]; then
    echo "Run commands:"
    echo '```bash'
    for c in "${run_cmds[@]}"; do
      echo "$c"
    done
    echo '```'
    echo
  else
    echo "Run commands: (not configured)"
    echo
  fi

  echo "Risk summary:"
  echo '```bash'
  echo "ai-risk --json"
  echo '```'
  echo
  echo "Generate context:"
  echo '```bash'
  echo "ai-context --force"
  echo '```'
} > "${out_dir}/commands.md"

{
  echo "# Integration Points"
  echo
  echo "Configured include paths:"
  if [[ ${#include_paths[@]} -eq 0 ]]; then
    echo "- (none configured)"
  else
    for p in "${include_paths[@]}"; do
      echo "- \`$p\`"
    done
  fi
  echo
  echo "Detected AI/Codex files:"
  found_any=0
  for p in AGENTS.md .codex/AGENTS.md .codex/project.yml .codex/risk-paths.yml .ai/context; do
    if [[ -e "${root}/${p}" ]]; then
      echo "- \`${p}\`"
      found_any=1
    fi
  done
  if [[ "$found_any" -eq 0 ]]; then
    echo "- (none found)"
  fi
} > "${out_dir}/integration-points.md"

{
  echo "# Risk Zones"
  echo
  echo "Configured risk file: \`${risk_file}\`"
  echo
  if [[ -f "${root}/${risk_file}" ]]; then
    echo "Configured rules:"
    ai_ctx_risk_rules_md "${root}/${risk_file}"
  else
    echo "Configured rules:"
    echo "- (risk config file not found)"
  fi
  echo
  echo "Risk source: __RISK_NOTE__"
} > "${out_dir}/risk-zones.md"
risk_note_escaped="$(printf '%s' "$risk_note" | sed 's/[\\&/]/\\&/g')"
awk -v v="${risk_note_escaped}" '{gsub(/__RISK_NOTE__/, v); print}' \
  "${out_dir}/risk-zones.md" > "${out_dir}/risk-zones.md.tmp"
mv "${out_dir}/risk-zones.md.tmp" "${out_dir}/risk-zones.md"

if [[ -n "$risk_json" ]]; then
  {
    echo
    echo '```json'
    printf '%s\n' "$risk_json"
    echo '```'
  } >> "${out_dir}/risk-zones.md"
fi

source_paths_inspected=()
for p in "${include_paths[@]}"; do
  source_paths_inspected+=("$p")
done
source_paths_inspected+=(".codex/project.yml")

{
  echo "{"
  echo "  \"repo_name\": \"$(ai_kit_json_escape "${repo_name}")\","
  echo "  \"project_type\": \"$(ai_kit_json_escape "${repo_type}")\","
  echo "  \"config_file\": \"$(ai_kit_json_escape ".codex/project.yml")\","
  echo "  \"risk_config_file\": \"$(ai_kit_json_escape "${risk_file}")\","
  echo "  \"output_dir\": \"$(ai_kit_json_escape "${out_dir_rel}")\","
  echo "  \"branch\": \"$(ai_kit_json_escape "$branch")\","
  echo "  \"commit_sha\": \"$(ai_kit_json_escape "$sha")\","
  echo "  \"generated_at\": \"$(ai_kit_now_iso)\","
  echo "  \"dirty_working_tree\": ${dirty},"
  echo "  \"source_paths_inspected\": ["
  for ((i = 0; i < ${#source_paths_inspected[@]}; i++)); do
    comma=","
    if [[ $i -eq $((${#source_paths_inspected[@]} - 1)) ]]; then
      comma=""
    fi
    printf '    "%s"%s\n' "$(ai_kit_json_escape "${source_paths_inspected[$i]}")" "$comma"
  done
  echo "  ]"
  echo "}"
} > "${out_dir}/generation-metadata.json"

echo "Generated ai-context in ${out_dir}"
