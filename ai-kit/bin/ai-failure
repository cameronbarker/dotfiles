#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "${SCRIPT_PATH}" ]]; do
  SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
  LINK_TARGET="$(readlink "${SCRIPT_PATH}")"
  if [[ "${LINK_TARGET}" == /* ]]; then
    SCRIPT_PATH="${LINK_TARGET}"
  else
    SCRIPT_PATH="${SCRIPT_DIR}/${LINK_TARGET}"
  fi
done
BIN_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
# shellcheck source=ai-kit/lib/common.sh
source "${BIN_DIR}/../lib/common.sh"

json_escape_local() {
  local s="${1:-}"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '%s' "$s"
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  echo "Usage: ai-failure -- <command ...>"
  exit 0
fi

if [[ "${1:-}" != "--" ]]; then
  echo "Usage: ai-failure -- <command ...>" >&2
  exit 64
fi
shift

if [[ "$#" -eq 0 ]]; then
  echo "No command provided." >&2
  exit 64
fi

root="$(ai_kit_repo_root)"
out_dir="${root}/ai-context"
out_file="${out_dir}/failure-summary.json"
mkdir -p "$out_dir"

stdout_file="$(mktemp)"
stderr_file="$(mktemp)"

set +e
"$@" >"$stdout_file" 2>"$stderr_file"
status=$?
set -e

stdout_sample="$(head -n 40 "$stdout_file")"
stderr_sample="$(head -n 40 "$stderr_file")"
cmd_str="$*"
combined_file="$(mktemp)"
cat "$stdout_file" "$stderr_file" > "$combined_file"

failed=true
failure_type="unknown_failure"
if [[ "$status" -eq 0 ]]; then
  failed=false
  failure_type="none"
else
  if grep -Eqi 'expected|got' "$combined_file"; then
    failure_type="assertion_failure"
  elif grep -qi 'LoadError' "$combined_file"; then
    failure_type="load_error"
  elif grep -qi 'SyntaxError' "$combined_file"; then
    failure_type="syntax_error"
  elif grep -Eqi 'Error:|Exception|:in `[^`]+`' "$combined_file"; then
    failure_type="exception"
  fi
fi

declare -a likely_files=()
declare -a line_map_files=()
declare -a line_map_values=()

is_ignored_path() {
  local p="${1:-}"
  if [[ "$p" == *"/vendor/bundle/"* ]] && [[ "$p" != "${root}/"* ]]; then
    return 0
  fi
  case "$p" in
    /usr/*|/System/*|/opt/homebrew/Cellar/*|*/.rbenv/*|*/.gem/*|*/gems/*|*/ruby/*)
      return 0
      ;;
  esac
  return 1
}

add_file_line() {
  local file="${1:-}"
  local line="${2:-}"
  local i current_lines found_file found_line
  [[ -n "$file" ]] || return 0

  found_file=0
  for i in "${!likely_files[@]}"; do
    if [[ "${likely_files[$i]}" == "$file" ]]; then
      found_file=1
      break
    fi
  done
  if [[ "$found_file" -eq 0 ]]; then
    likely_files+=("$file")
  fi

  if [[ -n "$line" ]]; then
    for i in "${!line_map_files[@]}"; do
      if [[ "${line_map_files[$i]}" == "$file" ]]; then
        current_lines="${line_map_values[$i]}"
        found_line=0
        IFS=',' read -r -a split_current <<< "$current_lines"
        for existing in "${split_current[@]}"; do
          if [[ "$existing" == "$line" ]]; then
            found_line=1
            break
          fi
        done
        if [[ "$found_line" -eq 0 ]]; then
          if [[ -n "$current_lines" ]]; then
            line_map_values[$i]="${current_lines},${line}"
          else
            line_map_values[$i]="${line}"
          fi
        fi
        return 0
      fi
    done
    line_map_files+=("$file")
    line_map_values+=("$line")
  fi
}

line_map_get() {
  local file="${1:-}"
  local i
  for i in "${!line_map_files[@]}"; do
    if [[ "${line_map_files[$i]}" == "$file" ]]; then
      printf '%s' "${line_map_values[$i]}"
      return 0
    fi
  done
  printf ''
  return 0
}

extract_file_candidates() {
  local token raw path line rel
  while IFS= read -r raw; do
    for token in $raw; do
      token="${token#\'}"
      token="${token#\"}"
      token="${token#\(}"
      token="${token#\`}"
      token="${token%\'}"
      token="${token%\"}"
      token="${token%\)}"
      token="${token%,}"
      token="${token%;}"
      token="${token%:in}"
      token="${token%\`}"
      if [[ "$token" =~ ^([^:]+):([0-9]+)(:.*)?$ ]]; then
        path="${BASH_REMATCH[1]}"
        line="${BASH_REMATCH[2]}"
      else
        continue
      fi
      if [[ "$path" != */* ]]; then
        continue
      fi
      if is_ignored_path "$path"; then
        continue
      fi
      if [[ "$path" == "${root}/"* ]]; then
        rel="${path#${root}/}"
        add_file_line "$rel" "$line"
      elif [[ "$path" == /* ]]; then
        add_file_line "$path" "$line"
      else
        add_file_line "$path" "$line"
      fi
    done
  done < "$combined_file"
}

extract_file_candidates

primary_file="null"
if [[ "${#likely_files[@]}" -gt 0 ]]; then
  primary_file="\"$(json_escape_local "${likely_files[0]}")\""
fi

likely_files_json="[]"
if [[ "${#likely_files[@]}" -gt 0 ]]; then
  likely_files_json="["
  for f in "${likely_files[@]}"; do
    likely_files_json+="\"$(json_escape_local "$f")\","
  done
  likely_files_json="${likely_files_json%,}]"
fi

line_numbers_json="{"
if [[ "${#likely_files[@]}" -gt 0 ]]; then
  for f in "${likely_files[@]}"; do
    lines="$(line_map_get "$f")"
    line_numbers_json+="\"$(json_escape_local "$f")\":["
    if [[ -n "$lines" ]]; then
      IFS=',' read -r -a split_lines <<< "$lines"
      for n in "${split_lines[@]}"; do
        line_numbers_json+="${n},"
      done
      line_numbers_json="${line_numbers_json%,}"
    fi
    line_numbers_json+="],"
  done
  line_numbers_json="${line_numbers_json%,}"
  line_numbers_json+="}"
else
  line_numbers_json="{}"
fi

declare -a recommended_cmds=()
recommended_cmds+=("ai-failure -- ${cmd_str}")
if [[ "$primary_file" != "null" ]]; then
  primary_rel="${likely_files[0]}"
  if [[ "$primary_rel" == test/* ]] && command -v bundle >/dev/null 2>&1 && command -v ruby >/dev/null 2>&1; then
    recommended_cmds+=("bundle exec ruby ${primary_rel}")
  fi
fi

recommended_json="["
if [[ "${#recommended_cmds[@]}" -gt 0 ]]; then
  for c in "${recommended_cmds[@]}"; do
    recommended_json+="\"$(json_escape_local "$c")\","
  done
fi
recommended_json="${recommended_json%,}]"

cat > "$out_file" <<JSON
{
  "generated_at": "$(ai_kit_now_iso)",
  "repo_root": "$(json_escape_local "$root")",
  "command": "$(json_escape_local "$cmd_str")",
  "exit_code": ${status},
  "failed": ${failed},
  "likely_files": ${likely_files_json},
  "primary_file": ${primary_file},
  "line_numbers": ${line_numbers_json},
  "failure_type": "$(json_escape_local "$failure_type")",
  "recommended_next_commands": ${recommended_json},
  "stdout_sample": "$(json_escape_local "$stdout_sample")",
  "stderr_sample": "$(json_escape_local "$stderr_sample")"
}
JSON

rm -f "$stdout_file" "$stderr_file" "$combined_file"

echo "Wrote ${out_file}"
exit "$status"
