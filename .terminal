# =============================================================================
# .terminal — shell config template (bash and zsh)
#
# Installation:
#   1. From the repo: ./install.sh   (appends a source line to ~/.bashrc)
#      Or manually: echo 'source /path/to/repo/.terminal' >> ~/.bashrc
#
#   2. Install dependencies:
#        Starship (prompt):   curl -sS https://starship.rs/install.sh | sh
#        Atuin (history):     default via ./install.sh (binary only; do not use setup.atuin.sh — it duplicates hooks)
#                             or: brew install atuin
#        fzf (fuzzy finder):  git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf && ~/.fzf/install
#        zoxide (dirs):       apt install zoxide  (default via ./install.sh) — or brew install zoxide
#        screen:              apt install screen  (default via ./install.sh)
#        z (legacy):          git clone https://github.com/rupa/z.git ~/.z-plugin  — only if no zoxide
#        bat (cat w/ color):  apt install bat  # installs as 'batcat' on Debian/Ubuntu
# =============================================================================

# -----------------------------------------------------------------------------
# Terminal
# -----------------------------------------------------------------------------
alias c='clear'

# -----------------------------------------------------------------------------
# Editor
# -----------------------------------------------------------------------------
alias vim='nvim'
export EDITOR="vim"
alias edit="${EDITOR:-vim}"

# -----------------------------------------------------------------------------
# Navigation
# -----------------------------------------------------------------------------
alias ..='cd ../'
alias ...='cd ../../'
alias ....='cd ../../../'
alias ~='cd ~'
alias -- -='cd -'

alias c='clear'
if command -v pbcopy &>/dev/null; then
  :
elif command -v xclip &>/dev/null; then
  pbcopy() { xclip -selection clipboard; }
elif command -v wl-copy &>/dev/null; then
  pbcopy() { wl-copy; }
fi
alias cwd='echo -n $PWD | pbcopy && echo "Copied current path to clipboard"'
if [[ -n "${BASH_VERSION:-}" ]]; then
  alias src='source ~/.bashrc'
elif [[ -n "${ZSH_VERSION:-}" ]]; then
  alias src='source ~/.zshrc'
fi

# -----------------------------------------------------------------------------
# File listing
# -----------------------------------------------------------------------------
alias ll='ls -la --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias lt='ls -lAht --color=auto'  # sort by modified time

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# -----------------------------------------------------------------------------
# Help
# -----------------------------------------------------------------------------
alias help='alias | grep'

# -----------------------------------------------------------------------------
# Git
# -----------------------------------------------------------------------------
alias ga='git add --all'
alias gb='git branch'
alias gc='git commit -m'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gd='git diff'
alias gf='git pull'
alias gl='git log --oneline --graph --decorate'
alias gr='git remote -v'
alias gs='git status'
alias gt='git push'
alias gst='git stash'
alias gstp='git stash pop'

# git commit with staged changes
gca() { git commit --amend --no-edit "$@"; }

# -----------------------------------------------------------------------------
# Rails
# -----------------------------------------------------------------------------
alias bi='bundle install'
alias rc='rails console'
alias rs='rails server'
alias rdb='rails db:migrate'
alias rdbs='rails db:migrate:status'
alias rlint='bundle exec standardrb'
alias rails_secrets='EDITOR=vim rails credentials:edit'
alias kill_rails='rm -rf tmp/pids/server.pid && lsof -ti:3000 | xargs kill -9'

# -----------------------------------------------------------------------------
# Utilities
# -----------------------------------------------------------------------------

# make a directory and cd into it
mkcd() { mkdir -p "$1" && cd "$1"; }

# extract common archive formats
extract() {
  case "$1" in
    *.tar.bz2) tar xjf "$1" ;;
    *.tar.gz)  tar xzf "$1" ;;
    *.tar.xz)  tar xJf "$1" ;;
    *.zip)     unzip "$1" ;;
    *.gz)      gunzip "$1" ;;
    *.bz2)     bunzip2 "$1" ;;
    *.rar)     unrar x "$1" ;;
    *)         echo "Unknown format: $1" ;;
  esac
}

# quick HTTP server in current dir
serve() { python3 -m http.server "${1:-8000}"; }

# find file by name
ff() { find . -name "*$1*" 2>/dev/null; }

# -----------------------------------------------------------------------------
# PATH additions (add project-specific paths here)
# -----------------------------------------------------------------------------
# export PATH="$HOME/.local/bin:$PATH"

# -----------------------------------------------------------------------------
# fzf — fuzzy finder (Ctrl-T file search; Ctrl-R stays fzf if Atuin is not installed)
# -----------------------------------------------------------------------------
# Debian/apt fzf is often too old for `fzf --bash` / `fzf --zsh` (prints "unknown option").
# Prefer ~/.fzf.bash from the git installer; otherwise use --bash/--zsh only if they work.
if command -v fzf &>/dev/null; then
  if [[ -n "${BASH_VERSION:-}" ]]; then
    if [[ -f "${HOME}/.fzf.bash" ]]; then
      # shellcheck source=/dev/null
      source "${HOME}/.fzf.bash"
    else
      _fzf_shell_init="$(fzf --bash 2>/dev/null)" || true
      [[ -n "${_fzf_shell_init}" ]] && eval "${_fzf_shell_init}"
      unset _fzf_shell_init
    fi
  elif [[ -n "${ZSH_VERSION:-}" ]]; then
    if [[ -f "${HOME}/.fzf.zsh" ]]; then
      # shellcheck source=/dev/null
      source "${HOME}/.fzf.zsh"
    else
      _fzf_shell_init="$(fzf --zsh 2>/dev/null)" || true
      [[ -n "${_fzf_shell_init}" ]] && eval "${_fzf_shell_init}"
      unset _fzf_shell_init
    fi
  fi
  export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border"
  # Use bat for fzf file previews if available
  if command -v batcat &>/dev/null; then
    export FZF_CTRL_T_OPTS="--preview 'batcat --color=always --line-range :50 {}'"
  elif command -v bat &>/dev/null; then
    export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :50 {}'"
  fi
fi

# -----------------------------------------------------------------------------
# Atuin — shell history (Ctrl-R); load after fzf so Atuin wins over fzf’s Ctrl-R.
# Ctrl-T remains fzf file search. Binary: ~/.atuin/bin (see ./install.sh).
# -----------------------------------------------------------------------------
if [[ -d "${HOME}/.atuin/bin" ]] && [[ ":${PATH}:" != *":${HOME}/.atuin/bin:"* ]]; then
  export PATH="${HOME}/.atuin/bin:${PATH}"
fi
if command -v atuin &>/dev/null; then
  if [[ -n "${BASH_VERSION:-}" ]]; then
    if [[ ! -f "${HOME}/.bash-preexec.sh" ]] && command -v curl &>/dev/null; then
      curl -fsSL -o "${HOME}/.bash-preexec.sh" \
        https://raw.githubusercontent.com/rcaloras/bash-preexec/master/bash-preexec.sh 2>/dev/null || true
    fi
    if [[ -f "${HOME}/.bash-preexec.sh" ]]; then
      # shellcheck source=/dev/null
      source "${HOME}/.bash-preexec.sh"
    fi
    eval "$(atuin init bash)"
  elif [[ -n "${ZSH_VERSION:-}" ]]; then
    eval "$(atuin init zsh)"
  fi
fi

# -----------------------------------------------------------------------------
# zoxide — smart directory jump (z, zi); falls back to rupa/z if zoxide not installed
# -----------------------------------------------------------------------------
if command -v zoxide &>/dev/null; then
  if [[ -n "${BASH_VERSION:-}" ]]; then
    eval "$(zoxide init bash)"
  elif [[ -n "${ZSH_VERSION:-}" ]]; then
    eval "$(zoxide init zsh)"
  fi
elif [[ -f ~/.z-plugin/z.sh ]]; then
  # shellcheck source=/dev/null
  source ~/.z-plugin/z.sh
fi

# -----------------------------------------------------------------------------
# bat — cat replacement with syntax highlighting
# -----------------------------------------------------------------------------
if command -v batcat &>/dev/null; then
  alias bat='batcat'
  alias cat='batcat --paging=never'
elif command -v bat &>/dev/null; then
  alias cat='bat --paging=never'
fi

# -----------------------------------------------------------------------------
# Prompt
# -----------------------------------------------------------------------------
export STARSHIP_CONFIG="${HOME}/.config/starship.toml"
if command -v starship &>/dev/null; then
  if [[ -n "${BASH_VERSION:-}" ]]; then
    eval "$(starship init bash)"
  elif [[ -n "${ZSH_VERSION:-}" ]]; then
    eval "$(starship init zsh)"
  fi
fi
