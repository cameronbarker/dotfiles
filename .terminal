# =============================================================================
# .terminal — shell config template (bash and zsh)
#
# Installation:
#   1. From the repo: ./install.sh   (installs zsh, creates ~/.zshrc, appends a source line)
#      Or manually: echo 'source /path/to/repo/.terminal' >> ~/.zshrc
#
#   2. Install dependencies:
#        Starship (prompt):   curl -sS https://starship.rs/install.sh | sh
#        Atuin (history):     default via ./install.sh (binary only; do not use setup.atuin.sh — it duplicates hooks)
#                             or: brew install atuin
#        Tailscale (VPN):     default via ./install.sh (client only; run tailscale up per machine — no auth keys in repo)
#                             or: brew install tailscale  /  curl -fsSL https://tailscale.com/install.sh | sh
#        fzf (fuzzy finder):  git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf && ~/.fzf/install
#        zoxide (dirs):       apt install zoxide  (default via ./install.sh) — or brew install zoxide
#        zsh-z (zsh dirs):    git clone --depth 1 https://github.com/agkozak/zsh-z ~/.zsh-z
#        screen:              apt install screen  (default via ./install.sh)
#        z (legacy):          git clone https://github.com/rupa/z.git ~/.z-plugin  — only if no zoxide
#        bat (cat w/ color):  apt install bat  # installs as 'batcat' on Debian/Ubuntu
#
# Modular pieces live under ./terminal/ (sourced below in dependency order).
# =============================================================================

_PB_TERMINAL_DIR=""
if [[ -n "${ZSH_VERSION:-}" ]]; then
  _PB_TERMINAL_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
elif [[ -n "${BASH_VERSION:-}" ]]; then
  _PB_TERMINAL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

# shellcheck source=terminal/zsh-cleanup.sh
source "${_PB_TERMINAL_DIR}/terminal/zsh-cleanup.sh"
# shellcheck source=terminal/core.sh
source "${_PB_TERMINAL_DIR}/terminal/core.sh"
# shellcheck source=terminal/navigation.sh
source "${_PB_TERMINAL_DIR}/terminal/navigation.sh"
# shellcheck source=terminal/tmux.sh
source "${_PB_TERMINAL_DIR}/terminal/tmux.sh"
# shellcheck source=terminal/aliases.sh
source "${_PB_TERMINAL_DIR}/terminal/aliases.sh"
# shellcheck source=terminal/git.sh
source "${_PB_TERMINAL_DIR}/terminal/git.sh"
# shellcheck source=terminal/systemd.sh
source "${_PB_TERMINAL_DIR}/terminal/systemd.sh"
# shellcheck source=terminal/rails.sh
source "${_PB_TERMINAL_DIR}/terminal/rails.sh"
# shellcheck source=terminal/utilities.sh
source "${_PB_TERMINAL_DIR}/terminal/utilities.sh"
# shellcheck source=terminal/scaffold.sh
source "${_PB_TERMINAL_DIR}/terminal/scaffold.sh"
# shellcheck source=terminal/path.sh
source "${_PB_TERMINAL_DIR}/terminal/path.sh"
# shellcheck source=terminal/fzf.sh
source "${_PB_TERMINAL_DIR}/terminal/fzf.sh"
# shellcheck source=terminal/atuin.sh
source "${_PB_TERMINAL_DIR}/terminal/atuin.sh"
# shellcheck source=terminal/directory-jump.sh
source "${_PB_TERMINAL_DIR}/terminal/directory-jump.sh"
# shellcheck source=terminal/bat.sh
source "${_PB_TERMINAL_DIR}/terminal/bat.sh"
# shellcheck source=terminal/starship.sh
source "${_PB_TERMINAL_DIR}/terminal/starship.sh"

unset _PB_TERMINAL_DIR
