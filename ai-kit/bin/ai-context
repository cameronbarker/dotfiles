#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "${SCRIPT_PATH}" ]]; do
  SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
  LINK_TARGET="$(readlink "${SCRIPT_PATH}")"
  if [[ "${LINK_TARGET}" == /* ]]; then
    SCRIPT_PATH="${LINK_TARGET}"
  else
    SCRIPT_PATH="${SCRIPT_DIR}/${LINK_TARGET}"
  fi
done
BIN_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
# shellcheck source=ai-kit/lib/common.sh
source "${BIN_DIR}/../lib/common.sh"

usage() {
  cat <<'USAGE'
Usage: ai-context [--force]

Generate ai-context orientation files.
Refuses to overwrite a non-empty ai-context/ directory unless --force is provided.
USAGE
}

force=0
case "${1:-}" in
  --help|-h)
    usage
    exit 0
    ;;
  --force)
    force=1
    shift
    ;;
esac

if [[ "$#" -gt 0 ]]; then
  usage >&2
  exit 64
fi

root="$(ai_kit_repo_root)"
out_dir="${root}/ai-context"

if [[ -d "$out_dir" ]]; then
  if find "$out_dir" -mindepth 1 -print -quit 2>/dev/null | grep -q .; then
    if [[ "$force" -ne 1 ]]; then
      echo "Refusing to overwrite non-empty ${out_dir}. Re-run with --force." >&2
      exit 2
    fi
  fi
fi

mkdir -p "$out_dir"

branch="unknown"
sha="unknown"
dirty=false
if command -v git >/dev/null 2>&1; then
  branch="$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
  sha="$(git -C "$root" rev-parse HEAD 2>/dev/null || echo unknown)"
  if [[ -n "$(git -C "$root" status --short 2>/dev/null || true)" ]]; then
    dirty=true
  fi
fi

risk_json=""
risk_note="ai-risk unavailable"
if [[ -x "${BIN_DIR}/ai-risk" ]]; then
  risk_json="$({ "${BIN_DIR}/ai-risk" --json 2>/dev/null || true; } | tail -n 1)"
  if [[ -n "$risk_json" ]]; then
    risk_note="Embedded from ai-risk --json"
  fi
fi

cat > "${out_dir}/README.md" <<'MD'
# AI Context

This folder is generated orientation material for planning/discussion.

Warning: generated context is orientation-only. Repository source files remain authoritative.
MD

cat > "${out_dir}/project-overview.md" <<'MD'
# Project Overview

- Repo: __REPO_NAME__
- Type: dotfiles/tooling
- Primary stack: Bash shell scripts and configuration files
- Key entrypoints: `install.sh`, `uninstall.sh`, `.terminal`

Generated context only; inspect live files before implementation.
MD
repo_name_escaped="$(printf '%s' "$(basename "$root")" | sed 's/[\\&/]/\\&/g')"
awk -v v="${repo_name_escaped}" '{gsub(/__REPO_NAME__/, v); print}' \
  "${out_dir}/project-overview.md" > "${out_dir}/project-overview.md.tmp"
mv "${out_dir}/project-overview.md.tmp" "${out_dir}/project-overview.md"

cat > "${out_dir}/architecture-map.md" <<'MD'
# Architecture Map

- `.terminal`: shell bootstrap and module load order
- `terminal/`: aliases, path, utilities, and integrations
- `.codex/`: agent guidance, rules, and skills
- `ai-kit/`: reusable AI/Codex helper scripts
MD

cat > "${out_dir}/commands.md" <<'MD'
# Commands

- Validate shell scripts:
```bash
bash -n install.sh uninstall.sh
```

- Risk summary:
```bash
ai-kit/bin/ai-risk --json
```

- Generate context:
```bash
ai-kit/bin/ai-context --force
```
MD

cat > "${out_dir}/integration-points.md" <<'MD'
# Integration Points

- Shell bootstrap: `.terminal`
- PATH convention: `terminal/path.sh`
- Agent guidance: `AGENTS.md`, `.codex/AGENTS.md`
- Risk policy: `.codex/risk-paths.yml`
MD

cat > "${out_dir}/risk-zones.md" <<'MD'
# Risk Zones

- `.codex/**`: agent policy and workflow controls
- `install.sh`, `uninstall.sh`: system-level shell actions
- `.terminal`, `terminal/**`: shell startup behavior
- `**/*secret*`: potential sensitive data handling

Risk source: __RISK_NOTE__
MD
risk_note_escaped="$(printf '%s' "$risk_note" | sed 's/[\\&/]/\\&/g')"
awk -v v="${risk_note_escaped}" '{gsub(/__RISK_NOTE__/, v); print}' \
  "${out_dir}/risk-zones.md" > "${out_dir}/risk-zones.md.tmp"
mv "${out_dir}/risk-zones.md.tmp" "${out_dir}/risk-zones.md"

if [[ -n "$risk_json" ]]; then
  {
    echo
    echo '```json'
    printf '%s\n' "$risk_json"
    echo '```'
  } >> "${out_dir}/risk-zones.md"
fi

cat > "${out_dir}/generation-metadata.json" <<JSON
{
  "repo_name": "$(ai_kit_json_escape "$(basename "$root")")",
  "branch": "$(ai_kit_json_escape "$branch")",
  "commit_sha": "$(ai_kit_json_escape "$sha")",
  "generated_at": "$(ai_kit_now_iso)",
  "dirty_working_tree": ${dirty},
  "source_paths_inspected": [
    "AGENTS.md",
    ".codex/AGENTS.md",
    "README.md",
    "install.sh",
    "uninstall.sh",
    ".terminal",
    "terminal/",
    ".codex/rules/"
  ]
}
JSON

echo "Generated ai-context in ${out_dir}"
